    {"name": ".dct-is-error", "appliesTo": [".dct-field"], "requiresDescendantAttributes": ["aria-invalid=true", "aria-describedby"]},
    {"name": ".dct-is-success", "appliesTo": [".dct-field", ".dct-message", ".dct-badge", ".dct-progress", ".dct-table tbody tr"]},
    {"name": ".dct-is-striped", "appliesTo": [".dct-table"]},
    {"name": ".dct-is-hoverable", "appliesTo": [".dct-table"]},
    {"name": ".dct-is-compact", "appliesTo": [".dct-table"]},
    {"name": ".dct-is-numeric", "appliesTo": [".dct-table th", ".dct-table td"]},
    {"name": ".dct-is-selected", "appliesTo": [".dct-table tbody tr"]}
  ],
  "attributes": [
    {"name": "data-dct-theme", "values": ["light", "dark"], "use": "explicit theme on the document root or a subtree"},
    {"name": "data-dct-density", "value": "compact", "use": "compact control, panel and navigation density on the document root or a subtree"},
    {"name": "type", "use": "required native type where implicit button or input behavior would be ambiguous"},
    {"name": "disabled", "use": "native button and form controls"},
    {"name": "readonly", "use": "input and textarea"},
    {"name": "required", "use": "required form controls"},
    {"name": "hidden", "use": "progressive .dct-navbar-toggle and collapsed .dct-navbar-menu synchronized by the application"},
    {"name": "open", "use": "initial native details state; native dialog state is managed through its API"},
    {"name": "href", "use": "real navigation destinations and .dct-skip-link fragment target"},
    {"name": "id", "use": "unique relationship target for labels, descriptions, names, navbar controls, popovers and skip links"},
    {"name": "for", "use": "associate label with a form control or progress element"},
    {"name": "alt", "use": "text alternative for informative images; empty for decorative images"},
    {"name": "tabindex", "values": ["0", "-1"], "use": "scrollable regions and programmatic skip-link targets; disabled links use -1"},
    {"name": "aria-label", "use": "accessible name when no visible label supplies one"},
    {"name": "aria-labelledby", "use": "accessible name from visible content"},
    {"name": "aria-describedby", "use": "associate a control with .dct-help"},
    {"name": "aria-hidden", "value": "true", "use": "decorative icons and text avatars when an adjacent name exists"},
    {"name": "aria-disabled", "value": "true", "use": "disabled links styled as buttons or pagination markers"},
    {"name": "aria-busy", "value": "true", "use": ".dct-button.dct-is-loading"},
    {"name": "aria-invalid", "value": "true", "use": "invalid control inside .dct-field.dct-is-error"},
    {"name": "aria-current", "value": "page", "use": "current navigation link"},
    {"name": "aria-expanded", "values": ["true", "false"], "use": "navbar toggle state"},
    {"name": "aria-controls", "use": "navbar toggle target id"},
    {"name": "aria-sort", "values": ["ascending", "descending", "none", "other"], "use": "application-provided sortable table headers"},
    {"name": "role", "values": ["alert", "img", "region", "status", "switch"], "use": "message urgency, standalone SVG names, scroll regions and switches"},
    {"name": "scope", "values": ["col", "row"], "use": "table header association"},
    {"name": "method", "value": "dialog", "use": "native dialog action form"},
    {"name": "popover", "use": ".dct-popover native behavior"},
    {"name": "popovertarget", "use": "button targeting a native popover id"},
    {"name": "max", "use": "maximum value of .dct-progress"},
    {"name": "value", "use": "current determinate progress value and native dialog action return value"}
  ],
