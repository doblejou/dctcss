{
  "schemaVersion": 2,
  "name": "dctcss",
  "version": "1.6.4",
  "prefix": "dct-",
  "stability": "stable",
  "attributeInventoryScope": "The attributes inventory lists attributes required or restricted by dctcss contracts. It is not an HTML allowlist and does not prohibit ordinary semantic attributes such as type, name, autocomplete, action or accept.",
  "applicationResponsibilities": [
    "Choose semantic HTML elements and provide accessible names, labels, descriptions and text alternatives.",
    "Validate, submit and persist form data, including file validation and protection against repeated submission.",
    "Synchronize dynamic native and ARIA states, visible messages and focus when validation or content changes.",
    "Prevent activation and navigation for disabled or loading links in application event handlers; CSS pointer suppression is not sufficient.",
    "Insert, update and remove dynamic messages; use status for non-urgent updates and alert only for urgent errors.",
    "Generate navigation URLs and current states, and implement dynamic tab panels only with the complete application interaction pattern.",
    "Sort, paginate and select table data, including buttons and aria-sort when sortable columns are provided.",
    "Keep indivisible amounts on one line with application CSS; .dct-is-numeric permits wrapping between words. Provide space or local scrolling for long single-line badges.",
    "Synchronize navbar hidden and aria-expanded states at initialization, on activation and when responsive layout changes.",
    "Open and close native dialogs, process returnValue and restore focus when appropriate.",
    "Update progress values and visible progress text.",
    "Manage any programmatic popover policy, data and actions beyond native popover behavior.",
    "Sanitize user-generated HTML before placing it in .dct-content."
  ],
  "artifacts": {
    "css": "dct.css",
    "cssMinified": "dct.min.css",
    "api": "dctcss-api.json",
    "recipes": "RECIPES.md",
    "changelog": "CHANGELOG.md",
    "license": "LICENSE",
    "checksums": "SHA256SUMS",
    "validator": "dctcss-validate.php"
  },
