    {"name": ".dct-card-subtitle", "kind": "component-part", "elements": ["p"], "requiresAncestor": [".dct-card", ".dct-card-body"]},
    {"name": ".dct-card-content", "kind": "component-part", "elements": ["p", "div"], "requiresAncestor": [".dct-card", ".dct-card-body"]},
    {"name": ".dct-card-actions", "kind": "component-part", "elements": ["div"], "requiresAncestor": [".dct-card", ".dct-card-body"], "requiresClasses": [".dct-cluster"]},
    {"name": ".dct-table-wrap", "kind": "component", "elements": ["div"], "requiresAttributes": ["tabindex=0", "role=region"], "requiresOneOfAttributes": ["aria-label", "aria-labelledby"], "requiresChild": [".dct-table"]},
    {"name": ".dct-table", "kind": "component", "elements": ["table"], "requiresAncestor": [".dct-table-wrap"], "requiresChild": ["caption.dct-table-caption"]},
    {"name": ".dct-table-caption", "kind": "component-part", "elements": ["caption"], "requiresAncestor": [".dct-table"]},
    {"name": ".dct-breadcrumb", "kind": "navigation", "elements": ["nav"], "marker": true, "requiresOneOfAttributes": ["aria-label", "aria-labelledby"], "requiresChild": [".dct-breadcrumb-list"]},
    {"name": ".dct-breadcrumb-list", "kind": "navigation-part", "elements": ["ol"], "requiresAncestor": [".dct-breadcrumb"]},
    {"name": ".dct-breadcrumb-item", "kind": "navigation-part", "elements": ["li"], "requiresAncestor": [".dct-breadcrumb", ".dct-breadcrumb-list"]},
    {"name": ".dct-tabs", "kind": "navigation", "elements": ["nav"], "requiresOneOfAttributes": ["aria-label", "aria-labelledby"], "requiresChild": [".dct-tabs-list"]},
    {"name": ".dct-tabs-list", "kind": "navigation-part", "elements": ["ul"], "requiresAncestor": [".dct-tabs"]},
    {"name": ".dct-tab", "kind": "navigation-part", "elements": ["a"], "requiresAncestor": [".dct-tabs", ".dct-tabs-list"]},
    {"name": ".dct-pagination", "kind": "navigation", "elements": ["nav"], "requiresOneOfAttributes": ["aria-label", "aria-labelledby"], "requiresChild": [".dct-pagination-list"]},
    {"name": ".dct-pagination-list", "kind": "navigation-part", "elements": ["ul"], "requiresAncestor": [".dct-pagination"]},
    {"name": ".dct-pagination-link", "kind": "navigation-part", "elements": ["a", "span"], "requiresAncestor": [".dct-pagination", ".dct-pagination-list"]},
