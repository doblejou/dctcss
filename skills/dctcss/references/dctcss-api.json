    {"name": ".dct-label", "kind": "form-structure", "elements": ["label"], "requiresAttributes": ["for"]},
    {"name": ".dct-help", "kind": "form-structure", "elements": ["p", "div"], "requiresAttributes": ["id"]},
    {"name": ".dct-input", "kind": "form-control", "elements": ["input"], "allowedTypes": ["text", "email", "password", "search", "url", "tel", "number", "date", "time", "datetime-local"]},
    {"name": ".dct-textarea", "kind": "form-control", "elements": ["textarea"]},
