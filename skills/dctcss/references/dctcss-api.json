  "decisionRules": [
    "Use button.dct-button for actions and a.dct-button for navigation.",
    "Use .dct-is-fullwidth for a button that stays full width and .dct-is-fullwidth-mobile for a button that returns to automatic width from 40rem.",
    "Use .dct-input only on the input types listed in allowedTypes.",
    "Use native disabled, readonly and required attributes instead of visual-only classes.",
    "Place error and success modifiers on .dct-field, not directly on controls.",
    "Use .dct-stack for vertical composition and .dct-cluster for wrapping horizontal composition.",
    "Use role=status for non-urgent dynamic messages and role=alert only for urgent errors.",
    "Use .dct-grid for auto-fitting columns without fixed breakpoints.",
    "Use article.dct-card for standalone content and keep .dct-card-body as a required child.",
    "Use .dct-display for a single prominent screen or editorial heading, .dct-title for page and section titles, .dct-subtitle for introductory copy and .dct-meta for brief contextual metadata; compose external spacing separately.",
    "Apply data-dct-density=compact to the document root or the smallest subtree that needs denser controls, panels and navigation; do not use per-component compact modifiers except the existing .dct-table.dct-is-compact contract.",
