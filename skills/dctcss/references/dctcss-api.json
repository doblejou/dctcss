    {"name": ".dct-message-actions", "kind": "component-part", "elements": ["div"], "requiresAncestor": [".dct-message", ".dct-message-body"]},
    {"name": ".dct-card", "kind": "component", "elements": ["article", "div"], "requiresChild": [".dct-card-body"]},
    {"name": ".dct-card-media", "kind": "component-part", "elements": ["div", "figure"], "requiresAncestor": [".dct-card"]},
    {"name": ".dct-card-body", "kind": "component-part", "elements": ["div"], "requiresAncestor": [".dct-card"]},
